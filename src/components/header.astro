---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="navbar">
  <div class="nav-container">
    <div class="logo">
      <span class="logo-mark">AP</span>
      <div class="logo-text">
        <strong>Abhishek Parpala</strong>
        <small>SEO & AI Search Strategist</small>
      </div>
    </div>
    <nav class="nav-links">
      <a href="/" class={isActive("/") ? "active" : ""}>Home</a>
      <a href="/about" class={isActive("/about") ? "active" : ""}>About</a>
      <a href="/#services">Services</a>
      <a href="/blog/" class={isActive("/blog") ? "active" : ""}>Blog</a>
      <a href="/#contact">Contact</a>
    </nav>
    <a href="mailto:abhishekparpala@gmail.com" class="nav-cta">Let's Work Together →</a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span class="menu-icon" aria-hidden="true"></span>
      <span class="sr-only menu-label">Open navigation</span>
    </button>
  </div>
  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation">
    <a href="/" class={isActive("/") ? "active" : ""}>Home</a>
    <a href="/about" class={isActive("/about") ? "active" : ""}>About</a>
    <a href="/#services">Services</a>
    <a href="/blog/" class={isActive("/blog") ? "active" : ""}>Blog</a>
    <a href="/#contact">Contact</a>
    <a href="mailto:abhishekparpala@gmail.com" class="mobile-nav-cta">Let's Work Together →</a>
  </nav>
</header>

<style>
  .navbar {
    border-bottom: 1px solid #eee;
    background: white;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .nav-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo-mark {
    background: #4b3cf0;
    color: white;
    font-weight: 700;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-text strong {
    font-size: 0.95rem;
  }

  .logo-text small {
    color: #888;
    font-size: 0.7rem;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    text-decoration: none;
    color: #333;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav-links a.active {
    color: #4b3cf0;
  }

  .nav-cta {
    background: #111;
    color: white;
    padding: 0.6rem 1.2rem;
    border-radius: 30px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .menu-toggle,
  .mobile-nav {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .nav-container {
      padding: 0.75rem 1rem;
    }

    .logo,
    .logo-text {
      min-width: 0;
    }

    .nav-links {
      display: none;
    }

    .nav-cta {
      margin-left: auto;
      padding: 0.55rem 0.85rem;
      font-size: 0.75rem;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      flex: 0 0 44px;
      padding: 0;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: #1a1a2e;
      cursor: pointer;
    }

    .menu-toggle:focus-visible,
    .mobile-nav a:focus-visible {
      outline: 2px solid #4b3cf0;
      outline-offset: 2px;
    }

    .menu-icon,
    .menu-icon::before,
    .menu-icon::after {
      display: block;
      width: 22px;
      height: 2px;
      border-radius: 999px;
      background: currentColor;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .menu-icon {
      position: relative;
    }

    .menu-icon::before,
    .menu-icon::after {
      position: absolute;
      left: 0;
      content: '';
    }

    .menu-icon::before {
      top: -7px;
    }

    .menu-icon::after {
      top: 7px;
    }

    .navbar.menu-open .menu-icon {
      background: transparent;
    }

    .navbar.menu-open .menu-icon::before {
      transform: translateY(7px) rotate(45deg);
    }

    .navbar.menu-open .menu-icon::after {
      transform: translateY(-7px) rotate(-45deg);
    }

    .mobile-nav {
      padding: 0.5rem 1rem 1rem;
      border-top: 1px solid #eee;
      background: white;
    }

    .navbar.menu-open .mobile-nav {
      display: block;
    }

    .mobile-nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0.65rem 1rem;
      border-radius: 8px;
      color: #333;
      font-size: 1rem;
      font-weight: 500;
      text-decoration: none;
    }

    .mobile-nav a.active {
      color: #4b3cf0;
    }

    .mobile-nav-cta {
      margin-top: 0.5rem;
      justify-content: center;
      background: #111;
      color: white !important;
      font-weight: 600 !important;
    }
  }

  @media (max-width: 520px) {
    .nav-cta {
      display: none;
    }

    .logo-text small {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.navbar');
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
  const menuLabel = document.querySelector<HTMLElement>('.menu-label');

  function setMenu(open: boolean) {
    if (!header || !menuButton || !mobileNav || !menuLabel) return;

    header.classList.toggle('menu-open', open);
    menuButton.setAttribute('aria-expanded', String(open));
    menuLabel.textContent = open ? 'Close navigation' : 'Open navigation';
  }

  menuButton?.addEventListener('click', () => {
    setMenu(!header?.classList.contains('menu-open'));
  });

  mobileNav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });
</script>
