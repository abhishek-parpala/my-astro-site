---
// Adjust this import to match your project structure —
// e.g. '../layouts/Layout.astro' if that's where your shared layout lives.
import Layout from '../layouts/Layout.astro';

const pillars = [
  {
    n: '01',
    title: 'AI Search Optimization',
    body: 'Improving brand visibility across ChatGPT, Perplexity, Gemini, and Google AI Overviews through content, authority, and citation opportunities.',
  },
  {
    n: '02',
    title: 'AI Search & Competitor Research',
    body: 'Identifying visibility gaps, competitor mentions, cited sources, and the content and authority signals influencing AI-generated answers.',
  },
  {
    n: '03',
    title: 'Content & On-Page SEO',
    body: 'Building focused topic coverage and technically clear, user-first pages that align search demand with a brand’s products and services.',
  },
  {
    n: '04',
    title: 'Digital PR & Community Marketing',
    body: 'Creating credible brand mentions, third-party citations, and relevant community coverage across publications, review sites, and Reddit.',
  },
  {
    n: '05',
    title: 'Off-Page SEO & Link Building',
    body: 'Planning and executing ethical link-building, outreach, and authority campaigns supported by several years of hands-on industry experience.',
  },
];

const timeline = [
  {
    year: '2022',
    text: 'Started building hands-on SEO experience through link building, outreach, and WordPress publishing.',
  },
  {
    year: 'Since',
    text: 'Operations manager at WHLinks, leading day-to-day delivery and supporting scalable, white-hat link-building campaigns.',
  },
  {
    year: 'Last year',
    text: 'Expanded into GEO and AI search, connecting traditional SEO fundamentals with brand visibility in generative answers.',
  },
  {
    year: 'Now',
    text: 'Applying the same framework to practical projects and preparing for an SEO or search marketing role.',
  },
];
---

<Layout
  title="About — Abhishek Parpala"
  description="SEO professional with experience in link building, off-page SEO, content, operations, and AI search visibility."
>
  <Fragment slot="hero" />
  <main class="about">
    <section class="hero">
      <div class="wrap about-hero-grid">
        <div class="about-hero-copy">
          <p class="kicker"><span></span> ABOUT ABHISHEK</p>
          <h1>SEO professional focused on modern search visibility.</h1>
          <p class="lede">
            I combine traditional SEO with the changing realities of AI search.
            My experience spans link building, content, digital PR, outreach,
            operations, and measuring whether brands are visible across Google
            and generative search platforms.
          </p>
          <a class="hero-link" href="/contact">Discuss an opportunity <span aria-hidden="true">↗</span></a>
        </div>
        <div class="about-hero-photo">
          <img src="/images/abhishek-about.png" alt="Abhishek Parpala" loading="lazy" />
          <span class="photo-caption">SEO · Content · Authority</span>
        </div>
      </div>
    </section>

    <section class="bio">
      <div class="wrap wrap--narrow">
        <p>
          I'm Abhishek Parpala, an SEO professional with experience in
          off-page SEO, outreach, WordPress publishing, campaign operations,
          and brand authority. Since 2022, I have worked closely with the
          processes that help businesses earn links, mentions, visibility,
          and measurable search coverage.
        </p>
        <p>
          I am also developing expertise in AI search optimization. I study
          how brands appear in ChatGPT, Perplexity, Gemini, and Google AI
          Overviews, then connect those findings to practical work in content,
          citations, digital PR, and authority building.
        </p>
      </div>
    </section>

    <section class="pillars">
      <div class="wrap">
        <h2>What I work on</h2>
        <ol class="pillar-list">
          {pillars.map((p) => (
            <li class="pillar">
              <span class="pillar-n">{p.n}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="timeline">
      <div class="wrap wrap--narrow">
        <h2>How I got here</h2>
        <ol class="tl-list">
          {timeline.map((t) => (
            <li class="tl-item">
              <span class="tl-year">{t.year}</span>
              <p>{t.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="now">
      <div class="wrap wrap--narrow">
        <h2>What I'm looking for</h2>
        <p>
          I am looking for an opportunity to contribute to an SEO, organic
          growth, or search marketing team. I bring hands-on off-page SEO
          experience, strong operational discipline, and a practical interest
          in how search visibility is evolving across traditional and AI
          platforms.
        </p>
        <a class="cta" href="/contact">Discuss an Opportunity</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .about {
    --ink: #1a1a2e;
    --ink-soft: #5f5b6d;
    --paper: #f7f5ff;
    --paper-soft: #625e70;
    --signal: #5942dc;
    --line-light: #e9e6f2;
    --serif: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    --sans: 'Inter', system-ui, sans-serif;
    font-family: var(--sans);
    color: var(--ink);
    background: #fff;
    overflow: hidden;
  }

  .wrap {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .wrap--narrow {
    max-width: 38rem;
  }

  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  p {
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  /* Hero */
  .hero {
    position: relative;
    background:
      radial-gradient(ellipse at 82% 25%, rgb(112 84 245 / 10%), transparent 34%),
      linear-gradient(180deg, #fff 0%, #fbfaff 100%);
    color: var(--ink);
    border-bottom: 1px solid var(--line-light);
    padding: clamp(3.5rem, 8vw, 5.5rem) 0;
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(250px, 0.72fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .about-hero-copy {
    min-width: 0;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--signal);
    margin: 0 0 1.15rem;
    letter-spacing: 0.04em;
  }

  .kicker span {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #36a879;
    box-shadow: 0 0 0 3px rgb(54 168 121 / 13%);
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    max-width: 17ch;
    letter-spacing: -0.045em;
    line-height: 1.07;
  }

  .lede {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--ink-soft);
    max-width: 39rem;
    margin: 1.2rem 0 1.5rem;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 48px;
    padding: 0.75rem 1.1rem;
    border-radius: 12px;
    background: #19162a;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
  }

  .hero-link:hover {
    transform: translateY(-2px);
    background: var(--signal);
  }

  .about-hero-photo {
    position: relative;
    max-width: 360px;
    justify-self: end;
    padding: 0.65rem;
    border: 1px solid #e8e2ff;
    border-radius: 25px;
    background: linear-gradient(145deg, #f1edff, #d2c8ff);
    box-shadow: 0 24px 60px rgb(51 36 123 / 14%);
  }

  .about-hero-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 0.9;
    border-radius: 19px;
    object-fit: cover;
    object-position: center 32%;
  }

  .photo-caption {
    position: absolute;
    right: -1rem;
    bottom: 1.4rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid #eeebf7;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 10px 24px rgb(25 22 42 / 12%);
    color: #4b3baf;
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Bio */
  .bio {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-bottom: 1px solid var(--line-light);
  }

  .bio p {
    font-size: 1.05rem;
    color: #2b2f38;
  }

  /* Pillars */
  .pillars {
    padding: clamp(3rem, 7vw, 5rem) 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line-light);
  }

  .pillars h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 2rem;
  }

  .pillar-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pillar {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.85rem;
    min-height: 150px;
    padding: 1.2rem;
    border: 1px solid #e9e5f5;
    border-radius: 17px;
    background: #fff;
    box-shadow: 0 8px 22px rgb(34 25 78 / 3%);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .pillar:hover {
    transform: translateY(-3px);
    border-color: #d3caf9;
    box-shadow: 0 14px 28px rgb(34 25 78 / 7%);
  }

  .pillar-n {
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    place-items: center;
    border-radius: 10px;
    background: #f0edff;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--signal);
  }

  .pillar h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .pillar p {
    color: var(--paper-soft);
    font-size: 0.9rem;
    margin: 0;
  }

  /* Timeline */
  .timeline {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-bottom: 1px solid var(--line-light);
  }

  .timeline h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 2rem;
  }

  .tl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line-light);
  }

  .tl-item {
    padding: 0 0 1.5rem 1.5rem;
    position: relative;
  }

  .tl-item::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.4rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
  }

  .tl-year {
    display: block;
    font-family: var(--sans);
    font-weight: 700;
    color: var(--signal);
    margin-bottom: 0.25rem;
  }

  .tl-item p {
    margin: 0;
  }

  /* Now / CTA */
  .now {
    padding: clamp(3rem, 7vw, 5rem) 0 clamp(4rem, 9vw, 6rem);
  }

  .now h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1rem;
  }

  .cta {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.85rem 1.6rem;
    background: #19162a;
    color: white;
    text-decoration: none;
    font-family: var(--sans);
    font-weight: 600;
    border-radius: 30px;
    transition: background 0.2s ease;
  }

  .cta:hover {
    background: var(--signal);
    color: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .hero-link,
    .pillar {
      transition: none;
    }

    .hero-link:hover,
    .pillar:hover {
      transform: none;
    }
  }

  @media (max-width: 700px) {
    .about-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .about-hero-photo {
      width: min(74%, 300px);
      justify-self: center;
    }

    .pillar-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .pillar {
      grid-template-columns: 2.3rem 1fr;
      min-height: 0;
      padding: 1rem;
    }

    .photo-caption {
      right: -0.5rem;
      bottom: 1rem;
    }
  }
</style>