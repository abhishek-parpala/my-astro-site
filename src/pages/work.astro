---
import Layout from '../layouts/Layout.astro';
import projects from '../data/projects';

const filters = ['All Work', 'SEO Operations', 'Off-Page SEO', 'AI Search (GEO)', 'Technical SEO', 'Practice Projects'];
---

<Layout
  title="Work & Practice Projects | Abhishek Parpala"
  description="SEO and AI search case studies, project breakdowns, and clearly labeled practice projects by Abhishek Parpala."
>
  <Fragment slot="hero"></Fragment>

  <main class="work-page">
    <section class="work-hero" aria-labelledby="work-heading">
      <div class="hero-copy">
        <span class="eyebrow">MY WORK</span>
        <h1 id="work-heading">Thoughtful SEO. <span>Practical work.</span></h1>
        <p>Explore how I approach organic growth, off-page authority, and AI search. Practice examples are clearly labeled.</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="signal-dashboard">
          <div class="signal-dashboard__top">
            <span class="signal-mark" aria-hidden="true">✳</span>
            <span>SEARCH LANDSCAPE</span>
            <span class="signal-arrow" aria-hidden="true">↗</span>
          </div>
          <h2>Visibility is built across more than one result page.</h2>
          <div class="signal-channels">
            <div><span class="channel-icon channel-icon--search">G</span><span><strong>Organic search</strong><small>Relevance · technical health</small></span><b>01</b></div>
            <div><span class="channel-icon channel-icon--ai">✳</span><span><strong>AI answers</strong><small>Sources · brand mentions</small></span><b>02</b></div>
            <div><span class="channel-icon channel-icon--authority">↗</span><span><strong>Web authority</strong><small>Content · trusted references</small></span><b>03</b></div>
          </div>
          <div class="signal-dashboard__foot"><span></span> Connected search signals</div>
        </div>
      </div>
    </section>

    <nav class="filters" aria-label="Filter projects">
      {filters.map((filter, index) => (
        <button
          class:list={['filter-button', { selected: index === 0 }]}
          type="button"
          data-filter={index === 0 ? 'all' : filter}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {filter}
        </button>
      ))}
    </nav>

    <section class="project-grid" aria-label="Projects">
      {projects.map((project) => (
        <a
          class="project-card"
          href={`/work/${project.id}`}
          aria-label={`View case study: ${project.title}`}
          data-category={project.category}
          data-type={project.type}
          id={project.id}
        >
          <div class:list={['project-preview', project.visual]} aria-hidden="true">
            <div class="preview-board">
              <div class="preview-board__top">
                <span>PROCESS SNAPSHOT</span>
                <span class="preview-board__spark" aria-hidden="true">✳</span>
              </div>
              <strong class="preview-board__title">{project.category}</strong>
              <div class="preview-steps">
                {project.steps.map((step, index) => (
                  <div class="preview-step">
                    <span>0{index + 1}</span>
                    <strong>{step}</strong>
                    <i aria-hidden="true">↗</i>
                  </div>
                ))}
              </div>
              <div class="preview-board__foot"><span></span> Illustrative workflow</div>
            </div>
          </div>
          <div class="project-copy">
            <span class="project-category">{project.category}</span>
            <span class="practice-label">{project.type === 'practice' ? 'Practice project' : 'Project'}</span>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            <div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
            <span class="card-action">View Case Study <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </section>

    <aside class="coming-soon">
      <div class="target-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="2.5"/><circle cx="24" cy="24" r="8" stroke="currentColor" stroke-width="2.5"/><path d="m24 24 15-15m-7 0h7v7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div>
        <h2>More Projects Coming Soon</h2>
        <p>I’m continually working on SEO and AI search projects, case studies, and experiments. Check back soon for more.</p>
      </div>
    </aside>
  </main>
</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;

      filterButtons.forEach((item) => {
        const selected = item === button;
        item.classList.toggle('selected', selected);
        item.setAttribute('aria-pressed', String(selected));
      });

      projectCards.forEach((card) => {
        const matches = filter === 'all' ||
          card.dataset.category === filter ||
          (filter === 'Practice Projects' && card.dataset.type === 'practice');
        card.hidden = !matches;
      });
    });
  });
</script>

<style>
  .work-page {
    max-width: 1160px;
    margin: 0 auto;
    padding: 1.6rem 1.5rem 2rem;
  }

  .work-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(290px, 0.62fr);
    align-items: center;
    gap: 2rem;
    padding: 1.8rem 0 1.4rem;
  }

  .hero-copy {
    max-width: 680px;
  }

  .eyebrow {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: #f0eaff;
    color: #4b20ed;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  h1, h2, p {
    margin-top: 0;
  }

  .work-hero h1 {
    margin: 0.9rem 0 0.65rem;
    color: #11101c;
    font-size: clamp(2.4rem, 4.7vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .work-hero h1 span {
    color: #5729f5;
  }

  .work-hero p {
    max-width: 660px;
    margin-bottom: 0;
    color: #4d4a5c;
    font-size: 1rem;
    line-height: 1.65;
  }

  .hero-art {
    overflow: hidden;
    border-radius: 24px;
    min-height: 270px;
  }

  .hero-art svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .signal-dashboard {
    display: flex;
    height: 100%;
    min-height: 270px;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid #e8e2ff;
    border-radius: 23px;
    background:
      radial-gradient(circle at 100% 0, rgb(142 121 255 / 22%), transparent 40%),
      linear-gradient(145deg, #fff, #f1edff);
    box-shadow: 0 18px 45px rgb(61 42 150 / 9%);
  }

  .signal-dashboard__top,
  .signal-dashboard__foot {
    display: flex;
    align-items: center;
  }

  .signal-dashboard__top {
    gap: 0.6rem;
    color: #77718d;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .signal-mark {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border-radius: 8px;
    background: #5b42e8;
    color: #fff;
    font-size: 1rem;
  }

  .signal-arrow {
    margin-left: auto;
    color: #5b42e8;
    font-size: 1.2rem;
  }

  .signal-dashboard h2 {
    max-width: 20ch;
    margin: 1.1rem 0 1rem;
    color: #211d37;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .signal-channels {
    display: grid;
    gap: 0.5rem;
  }

  .signal-channels > div {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid #ebe8f5;
    border-radius: 11px;
    background: rgb(255 255 255 / 83%);
  }

  .channel-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
    place-items: center;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .channel-icon--search { background: #eef4ff; color: #4285f4; }
  .channel-icon--ai { background: #e9f7f0; color: #258d65; }
  .channel-icon--authority { background: #f1edff; color: #6048dc; }

  .signal-channels strong,
  .signal-channels small {
    display: block;
  }

  .signal-channels strong {
    color: #28243b;
    font-size: 0.78rem;
  }

  .signal-channels small {
    margin-top: 0.1rem;
    color: #777285;
    font-size: 0.65rem;
  }

  .signal-channels > div > b {
    margin-left: auto;
    color: #aaa4bd;
    font-size: 0.65rem;
  }

  .signal-dashboard__foot {
    gap: 0.45rem;
    margin-top: 0.9rem;
    color: #777285;
    font-size: 0.67rem;
  }

  .signal-dashboard__foot span,
  .preview-board__foot span {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: #36a879;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.5rem 0 1.25rem;
  }

  .filter-button {
    min-height: 34px;
    padding: 0.35rem 0.9rem;
    border: 1px solid #dedbe8;
    border-radius: 999px;
    background: white;
    color: #252334;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .filter-button:hover,
  .filter-button:focus-visible {
    border-color: #5729f5;
  }

  .filter-button:focus-visible {
    outline: 2px solid #725de8;
    outline-offset: 3px;
  }

  .filter-button.selected {
    border-color: #5729f5;
    background: #5729f5;
    color: white;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 1.15rem;
    min-width: 0;
    padding: 0.8rem;
    border: 1px solid #e9e6f3;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 8px 26px rgb(35 23 84 / 4%);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: #d3c8ff;
    box-shadow: 0 8px 22px rgb(35 23 84 / 8%);
  }

  .project-card:focus-visible {
    outline: 3px solid #8a72ff;
    outline-offset: 3px;
  }

  .project-card[hidden] {
    display: none;
  }

  .project-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 200px;
    overflow: hidden;
    border-radius: 14px;
    background: linear-gradient(140deg, #f5f2ff, #e8e2ff);
  }

  .preview-board {
    width: calc(100% - 1.1rem);
    padding: 0.9rem;
    border: 1px solid rgb(255 255 255 / 85%);
    border-radius: 13px;
    background: rgb(255 255 255 / 90%);
    box-shadow: 0 10px 24px rgb(47 31 108 / 9%);
  }

  .preview-board__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #827c96;
    font-size: 0.57rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .preview-board__spark {
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border-radius: 7px;
    background: #f0edff;
    color: #6048dc;
    font-size: 0.85rem;
  }

  .preview-board__title {
    display: block;
    margin: 0.7rem 0;
    color: #28243b;
    font-size: 0.8rem;
  }

  .preview-steps {
    display: grid;
    gap: 0.4rem;
  }

  .preview-step {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    padding: 0.44rem 0.55rem;
    border: 1px solid #eeebf5;
    border-radius: 8px;
    background: #fff;
  }

  .preview-step > span {
    color: #8d84b0;
    font-size: 0.6rem;
    font-weight: 700;
  }

  .preview-step > strong {
    overflow: hidden;
    color: #484456;
    font-size: 0.65rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview-step > i {
    margin-left: auto;
    color: #6048dc;
    font-size: 0.7rem;
    font-style: normal;
  }

  .preview-board__foot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.65rem;
    color: #827c96;
    font-size: 0.57rem;
  }

  .dashboard {
    width: 100%;
    padding: 0.6rem 0.65rem 0.55rem;
    border: 1px solid #f0edf5;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 6px 18px rgb(38 25 86 / 7%);
  }

  .dashboard-top {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid #f0eef5;
    color: #252334;
    font-size: 0.57rem;
  }

  .google-mark {
    color: #4285f4;
    font-weight: 800;
  }

  .menu-dots {
    margin-left: auto;
    color: #999;
  }

  .dashboard-title {
    padding-top: 0.45rem;
    font-size: 0.56rem;
    font-weight: 600;
  }

  .line-chart {
    display: block;
    width: 100%;
    height: 68px;
  }

  .metric-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
  }

  .metric-row span {
    padding: 0.28rem;
    border-radius: 5px;
    background: #faf9fc;
    color: #666273;
    font-size: 0.42rem;
  }

  .metric-row strong {
    display: block;
    color: #22202e;
    font-size: 0.67rem;
  }

  .backlink-window {
    width: 96%;
    padding: 0.65rem;
    border-radius: 12px;
    background: #273448;
    box-shadow: 0 8px 18px rgb(28 35 54 / 22%);
  }

  .window-title {
    padding: 0 0 0.55rem;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .window-title::first-letter {
    color: #f7a932;
  }

  .window-title span {
    float: right;
    color: #9da8ba;
  }

  .referring-box {
    padding: 0.6rem;
    border-radius: 7px;
    background: white;
  }

  .referring-box small {
    display: block;
    color: #42404a;
    font-size: 0.53rem;
  }

  .referring-box strong {
    display: block;
    margin-top: 0.3rem;
    color: #252334;
    font-size: 1.05rem;
  }

  .referring-box em {
    color: #298d57;
    font-size: 0.55rem;
    font-style: normal;
  }

  .bars {
    display: flex;
    align-items: end;
    justify-content: end;
    gap: 4px;
    height: 30px;
    margin-top: -1.5rem;
  }

  .bars i {
    width: 9px;
    border-radius: 2px 2px 0 0;
    background: #6544f5;
  }

  .bars i:nth-child(1) { height: 5px; }
  .bars i:nth-child(2) { height: 8px; }
  .bars i:nth-child(3) { height: 11px; }
  .bars i:nth-child(4) { height: 15px; }
  .bars i:nth-child(5) { height: 20px; }
  .bars i:nth-child(6) { height: 25px; }
  .bars i:nth-child(7) { height: 30px; }

  .ai-window {
    width: 96%;
    padding: 0.75rem;
    border: 1px solid #e7e1f4;
    border-radius: 11px;
    background: linear-gradient(135deg, #fff, #f2edff);
  }

  .chat-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #312e3d;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .chat-brand span {
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 6px;
    background: #258d65;
    color: white;
  }

  .ai-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
    margin-top: 0.7rem;
  }

  .answer-lines {
    display: grid;
    align-content: center;
    gap: 6px;
    padding: 0.35rem;
  }

  .answer-lines i {
    height: 6px;
    border-radius: 4px;
    background: #d7ceef;
  }

  .answer-lines i:first-child {
    background: #9272f5;
  }

  .brand-list {
    display: grid;
    gap: 0.4rem;
    padding: 0.5rem;
    border-radius: 7px;
    background: white;
    color: #353242;
    font-size: 0.47rem;
  }

  .brand-list b {
    color: #5842d5;
  }

  .audit-window {
    width: 100%;
    padding: 0.7rem;
    border-radius: 10px;
    background: white;
    box-shadow: 0 5px 18px rgb(30 34 54 / 9%);
  }

  .window-controls {
    display: flex;
    gap: 4px;
    margin: -0.7rem -0.7rem 0.55rem;
    padding: 0.45rem 0.6rem;
    border-radius: 10px 10px 0 0;
    background: #eeedf3;
  }

  .window-controls i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fa6f67;
  }

  .window-controls i:nth-child(2) { background: #f4c754; }
  .window-controls i:nth-child(3) { background: #52bf7c; }

  .audit-window > strong {
    font-size: 0.65rem;
  }

  .audit-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.45rem;
  }

  .audit-score {
    display: grid;
    width: 70px;
    height: 70px;
    place-content: center;
    border: 7px solid #45b95b;
    border-radius: 50%;
    color: #253044;
    font-weight: 700;
  }

  .audit-score span {
    display: inline;
    font-size: 0.78rem;
    line-height: 1;
  }

  .audit-score small {
    font-size: 0.42rem;
  }

  .audit-checks {
    display: grid;
    gap: 0.3rem;
    font-size: 0.42rem;
  }

  .audit-checks b {
    float: right;
    color: #2caa51;
    font-size: 0.65rem;
  }

  .project-copy {
    min-width: 0;
    padding: 0.25rem 0.35rem 0.25rem 0;
  }

  .project-category {
    display: inline-block;
    margin-bottom: 0.55rem;
    padding: 0.23rem 0.6rem;
    border-radius: 999px;
    background: #f0edff;
    color: #5138d6;
    font-size: 0.65rem;
    font-weight: 600;
  }

  .practice-label {
    display: inline-block;
    margin: 0 0 0.55rem 0.25rem;
    padding: 0.23rem 0.6rem;
    border-radius: 999px;
    background: #f3f2f6;
    color: #514e5e;
    font-size: 0.65rem;
    font-weight: 600;
  }

  .project-copy h2 {
    margin-bottom: 0.5rem;
    color: #171522;
    font-size: 1.12rem;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .project-copy > p {
    margin-bottom: 0.65rem;
    color: #454252;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.65rem;
  }

  .project-tags span {
    padding: 0.22rem 0.5rem;
    border-radius: 999px;
    background: #f0eaff;
    color: #4022bd;
    font-size: 0.62rem;
    font-weight: 600;
  }

  .card-action {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: #5138d6;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .card-action span {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .project-card:hover .card-action span {
    transform: translateX(3px);
  }

  .coming-soon {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.8rem;
    padding: 1.3rem 2.2rem;
    border-radius: 18px;
    background: linear-gradient(110deg, #3925b8, #654de8 72%, #7865ed);
    color: white;
  }

  .target-icon {
    display: grid;
    width: 76px;
    height: 76px;
    flex: 0 0 76px;
    place-items: center;
    border-radius: 14px;
    background: rgb(255 255 255 / 18%);
  }

  .target-icon svg {
    width: 42px;
    height: 42px;
  }

  .coming-soon > div:last-child {
    padding-left: 1.5rem;
    border-left: 1px solid rgb(255 255 255 / 55%);
  }

  .coming-soon h2 {
    margin-bottom: 0.2rem;
    font-size: 1.35rem;
  }

  .coming-soon p {
    max-width: 720px;
    margin-bottom: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .project-card {
      grid-template-columns: 1fr;
      align-content: start;
    }

    .project-preview {
      min-height: 180px;
    }

    .project-copy {
      padding: 0.2rem 0.25rem 0.35rem;
    }
  }

  @media (max-width: 650px) {
    .work-page {
      padding: 1rem 1rem 1.5rem;
    }

    .work-hero {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      padding: 1.2rem 0 1rem;
    }

    .work-hero h1 {
      font-size: clamp(2.2rem, 10vw, 3.1rem);
