<script>
  function initPlatformRotator(root: HTMLElement) {
    // Guard against double-init (Astro/Vite HMR reconnects in dev mode
    // can otherwise attach this twice, desyncing the rotation).
    if (root.dataset.rotatorInit === "true") return;
    root.dataset.rotatorInit = "true";

    const items = Array.from(root.querySelectorAll<HTMLElement>(".platform-badge"));
    if (items.length < 2) return;

    let current = items.findIndex((el) => el.classList.contains("is-active"));
    if (current === -1) current = 0;

    const DISPLAY_MS = 3000; // how long each badge stays fully visible before crossfading

    function tick() {
      const next = (current + 1) % items.length;

      // Swapping both classes in the same tick means the outgoing badge's
      // fade-out and the incoming badge's fade-in run concurrently on the
      // same 0.5s transition — a real crossfade, so there's never a moment
      // where every badge is at opacity 0.
      items[current].classList.remove("is-active");
      items[next].classList.add("is-active");

      current = next;
    }

    setInterval(tick, DISPLAY_MS);
  }

  const rotator = document.getElementById("platform-rotator");
  if (rotator) initPlatformRotator(rotator);
</script>
