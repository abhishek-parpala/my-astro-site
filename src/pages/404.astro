---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Abhishek Parpala"
  description="The page you are looking for could not be found."
  noIndex
>
  <Fragment slot="hero" />
  <main class="not-found">
    <span class="eyebrow">404 · PAGE NOT FOUND</span>
    <h1>This page seems to be off the map.</h1>
    <p>The link may be outdated, or the page may have moved. Head back home or explore my work.</p>
    <div class="actions">
      <a class="primary" href="/">Go to homepage</a>
      <a class="secondary" href="/work">Explore my work</a>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    max-width: 760px;
    min-height: 55vh;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .eyebrow {
    color: #5138d6;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 650px;
    margin: 0.8rem 0;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1.05;
  }

  p {
    max-width: 560px;
    margin: 0;
    color: #5f5b6d;
    font-size: 1.05rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .actions a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.1rem;
    border: 1px solid #e2dfec;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .actions .primary {
    border-color: #19162a;
    background: #19162a;
    color: #fff;
  }

  .actions .secondary {
    color: #242135;
  }

  .actions a:focus-visible {
    outline: 2px solid #5138d6;
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .not-found {
      min-height: 48vh;
      padding: 4rem 1rem;
    }
  }
</style>
