---
import Layout from '../layouts/Layout.astro';

const email = 'abhishekparpala@gmail.com';
---

<Layout
  title="Contact | Abhishek Parpala"
  description="Get in touch with Abhishek Parpala about SEO, AI Search, GEO, and search visibility."
>
  <Fragment slot="hero"></Fragment>

  <main class="contact-page">
    <section class="contact-hero">
      <span class="eyebrow">CONTACT</span>
      <h1>Let's talk about your search visibility.</h1>
      <p>Have a question about SEO, AI Search, GEO, or improving your brand's visibility across Google and AI search? I'd be happy to hear what you're working on.</p>
    </section>

    <section class="contact-method" aria-labelledby="email-heading">
      <div>
        <span class="eyebrow">EMAIL</span>
        <h2 id="email-heading">Email me</h2>
        <a class="email-address" href={`mailto:${email}`}>{email}</a>
      </div>
      <a class="button" href={`mailto:${email}`}>Work With Me →</a>
    </section>

    <section class="elsewhere" aria-labelledby="elsewhere-heading">
      <span class="eyebrow">ELSEWHERE</span>
      <h2 id="elsewhere-heading">Find me online</h2>
      <div class="social-links">
        <a href="https://www.linkedin.com/in/abhishekparpala/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://www.youtube.com/@abhishekparpala" target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .contact-hero {
    max-width: 760px;
    padding: 5rem 0 4rem;
  }

  .eyebrow {
    color: #4b3cf0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  .contact-hero h1 {
    max-width: 700px;
    margin: 0.6rem 0 1rem;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .contact-hero p {
    max-width: 680px;
    margin-bottom: 0;
    color: #555;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .contact-method {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem 2rem;
    border: 1px solid #eee;
    border-radius: 16px;
    background: #fafafa;
  }

  .contact-method h2,
  .elsewhere h2 {
    margin: 0.55rem 0 0.5rem;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    line-height: 1.2;
  }

  .email-address {
    color: #4b3cf0;
    font-size: 1.05rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0.75rem 1.35rem;
    border-radius: 30px;
    background: #111;
    color: white;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .elsewhere {
    padding: 4rem 0 0;
  }

  .social-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: 1.5rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding: 1rem 1.25rem;
    border: 1px solid #eee;
    border-radius: 12px;
    color: #333;
    font-weight: 600;
    text-decoration: none;
  }

  .social-links span {
    color: #4b3cf0;
  }

  @media (max-width: 600px) {
    .contact-page {
      padding: 0 1rem 4rem;
    }

    .contact-hero {
      padding: 3.5rem 0 3rem;
    }

    .contact-hero p {
      font-size: 1rem;
    }

    .contact-method {
      align-items: stretch;
      flex-direction: column;
      padding: 2rem 1.5rem;
    }

    .button {
      width: 100%;
      white-space: normal;
    }

    .elsewhere {
      padding-top: 3rem;
    }

    .social-links {
      grid-template-columns: 1fr;
    }
  }
</style>
