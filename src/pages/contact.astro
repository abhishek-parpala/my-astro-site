---
import Layout from '../layouts/Layout.astro';

const email = 'abhishekparpala@gmail.com';
---

<Layout
  title="Contact | Abhishek Parpala"
  description="Get in touch with Abhishek Parpala about SEO, AI Search, GEO, and search visibility."
>
  <Fragment slot="hero"></Fragment>

  <main class="contact-page">
    <section class="contact-hero">
      <span class="eyebrow">CONTACT</span>
      <h1>Let's talk about <span>search visibility.</span></h1>
      <p>Interested in an SEO, organic growth, or search marketing opportunity? I'd be glad to connect and share how my experience could support your team.</p>
    </section>

    <section class="contact-method" aria-labelledby="email-heading">
      <div>
        <span class="eyebrow">EMAIL</span>
        <h2 id="email-heading">Email me</h2>
        <a class="email-address" href={`mailto:${email}`}>{email}</a>
      </div>
      <a class="button" href={`mailto:${email}`}>Discuss an opportunity <span aria-hidden="true">↗</span></a>
    </section>

    <section class="elsewhere" aria-labelledby="elsewhere-heading">
      <span class="eyebrow">ELSEWHERE</span>
      <h2 id="elsewhere-heading">Find me online</h2>
      <div class="social-links">
        <a href="https://www.linkedin.com/in/abhishekparpala/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://www.youtube.com/@abhishekparpala" target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/abhishek-parpala" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }

  .contact-hero {
    max-width: 760px;
    padding: 5rem 0 3.5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.7rem;
    border: 1px solid #e8e2ff;
    border-radius: 999px;
    background: #f7f5ff;
    color: #5138d6;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  .contact-hero h1 {
    max-width: 700px;
    margin: 0.6rem 0 1rem;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.055em;
  }

  .contact-hero h1 span {
    color: #5942dc;
  }

  .contact-hero p {
    max-width: 680px;
    margin-bottom: 0;
    color: #5f5b6d;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .contact-method {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem;
    border: 1px solid #e9e6f3;
    border-radius: 22px;
    background:
      radial-gradient(circle at 100% 0, rgb(112 84 245 / 9%), transparent 34%),
      linear-gradient(135deg, #fff, #faf9ff);
    box-shadow: 0 18px 42px rgb(34 25 78 / 5%);
  }

  .contact-method h2,
  .elsewhere h2 {
    margin: 0.55rem 0 0.5rem;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    line-height: 1.2;
  }

  .email-address {
    color: #5138d6;
    font-size: 1.05rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0.75rem 1.35rem;
    gap: 0.5rem;
    border-radius: 12px;
    background: #19162a;
    color: white;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 150ms ease, transform 150ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
    background: #5138d6;
  }

  .button:focus-visible,
  .social-links a:focus-visible {
    outline: 2px solid #725de8;
    outline-offset: 3px;
  }

  .elsewhere {
    padding: 4rem 0 0;
  }

  .social-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    padding: 1rem;
    border: 1px solid #e9e6f3;
    border-radius: 13px;
    background: #fff;
    color: #343044;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .social-links a:hover {
    transform: translateY(-2px);
    border-color: #c9bef9;
  }

  .social-links span {
    color: #5138d6;
  }

  @media (max-width: 600px) {
    .contact-page {
      padding: 0 1rem 4rem;
    }

    .contact-hero {
      padding: 3.5rem 0 2.75rem;
    }

    .contact-hero p {
      font-size: 1rem;
    }

    .contact-method {
      align-items: stretch;
      flex-direction: column;
      padding: 1.6rem 1.25rem;
    }

    .button {
      width: 100%;
      white-space: normal;
    }

    .elsewhere {
      padding-top: 3rem;
    }

    .social-links {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .social-links a {
      transition: none;
    }

    .button:hover,
    .social-links a:hover {
      transform: none;
    }
  }
</style>
