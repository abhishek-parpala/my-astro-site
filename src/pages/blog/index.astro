---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Layout
  title="Blog | Abhishek Parpala"
  description="Writing on GEO, AEO, and getting brands recommended by AI search platforms."
>
  <Fragment slot="hero"></Fragment>

  <main class="blog-index">
    <header class="blog-header">
      <span class="eyebrow">BLOG</span>
      <h1>GEO & AEO Notes</h1>
      <p>Practical notes on getting brands recommended by ChatGPT, Perplexity, Google AI Overviews, Claude and Gemini.</p>
    </header>

    <div class="post-list">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="post-card">
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <time datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .blog-index {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .blog-header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    color: #4b3cf0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .blog-header h1 {
    font-size: 2.2rem;
    margin: 0.6rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .blog-header p {
    color: #555;
    max-width: 520px;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .post-card {
    display: block;
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .post-card:hover {
    border-color: #4b3cf0;
  }

  .post-card h2 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .post-card p {
    color: #666;
    font-size: 0.92rem;
    margin: 0 0 0.8rem;
  }

  .post-card time {
    font-size: 0.8rem;
    color: #999;
  }
</style>