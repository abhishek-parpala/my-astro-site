---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<Layout
  title="Blog | Abhishek Parpala"
  description="Writing on GEO, AEO, and getting brands recommended by AI search platforms."
>
  <Fragment slot="hero"></Fragment>
  
  <main class="blog-index">
    <header class="blog-header">
      <span class="eyebrow">BLOG</span>
      <h1>SEO & AI Search Notes</h1>
      <p>Practical notes on getting brands recommended by ChatGPT, Perplexity, Google AI Overviews, Claude and Gemini.</p>
    </header>

    <div class="post-list">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="post-card">
          {post.data.image && (
            <div class="post-thumb">
              <img
                src={post.data.image}
                alt={post.data.title}
                loading="lazy"
              />
            </div>
          )}
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <time datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .blog-index {
    max-width: 900px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 6rem;
  }

  .blog-header {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    display: inline-flex;
    padding: 0.4rem 0.7rem;
    border: 1px solid #e8e2ff;
    border-radius: 999px;
    background: #f7f5ff;
    color: #5138d6;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .blog-header h1 {
    margin: 0.85rem 0 0.8rem;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
  }

  .blog-header p {
    color: #5f5b6d;
    max-width: 520px;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .post-card {
    display: block;
    background: #fff;
    border: 1px solid #e9e6f3;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 8px 26px rgb(35 23 84 / 4%);
    transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
  }

  .post-card:hover {
    transform: translateY(-3px);
    border-color: #d3caf9;
    box-shadow: 0 16px 34px rgb(35 23 84 / 9%);
  }

  .post-card:focus-visible {
    outline: 3px solid #8a72ff;
    outline-offset: 3px;
  }

  .post-thumb {
    width: 100%;
    overflow: hidden;
    background: #f0edff;
  }

  .post-thumb img {
    display: block;
    width: 100%;
    max-height: 370px;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .post-card:hover .post-thumb img {
    transform: scale(1.025);
  }

  .post-card h2 {
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    line-height: 1.25;
    margin: 1.5rem 1.5rem 0.6rem;
    letter-spacing: -0.03em;
  }

  .post-card p {
    color: #625e70;
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 1.5rem 0.8rem;
  }

  .post-card time {
    display: block;
    font-size: 0.8rem;
    color: #777285;
    margin: 0 1.5rem 1.5rem;
  }

  @media (max-width: 600px) {
    .blog-index {
      padding: 3.25rem 1rem 4rem;
    }

    .blog-header {
      margin-bottom: 2rem;
    }

    .blog-header h1 {
      font-size: clamp(2rem, 9vw, 2.5rem);
    }

    .post-card h2 {
      margin: 1.25rem 1.25rem 0.5rem;
    }

    .post-card p {
      margin-right: 1.25rem;
      margin-left: 1.25rem;
    }

    .post-card time {
      margin: 0 1.25rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-thumb img {
      transition: none;
    }

    .post-card:hover,
    .post-card:hover .post-thumb img {
      transform: none;
    }
  }
</style>
