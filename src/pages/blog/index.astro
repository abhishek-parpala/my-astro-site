---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<Layout
  title="Blog | Abhishek Parpala"
  description="Writing on GEO, AEO, and getting brands recommended by AI search platforms."
>
  <Fragment slot="hero"></Fragment>
  
  <main class="blog-index">
    <header class="blog-header">
      <span class="eyebrow">BLOG</span>
      <h1>SEO & AI Search Notes</h1>
      <p>Practical notes on getting brands recommended by ChatGPT, Perplexity, Google AI Overviews, Claude and Gemini.</p>
    </header>

    <div class="post-list">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="post-card">
          {post.data.image && (
            <div class="post-thumb">
              <img
                src={post.data.image}
                alt={post.data.title}
              />
            </div>
          )}
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <time datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .blog-index {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .blog-header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    color: #4b3cf0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .blog-header h1 {
    font-size: 2.2rem;
    margin: 0.6rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .blog-header p {
    color: #555;
    max-width: 520px;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .post-card {
    display: block;
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .post-card:hover {
    border-color: #4b3cf0;
  }

  .post-thumb {
    width: 100%;
  }

  .post-thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .post-card h2 {
    font-size: 1.2rem;
    margin: 1.5rem 1.5rem 0.5rem;
  }

  .post-card p {
    color: #666;
    font-size: 0.92rem;
    margin: 0 1.5rem 0.8rem;
  }

  .post-card time {
    display: block;
    font-size: 0.8rem;
    color: #999;
    margin: 0 1.5rem 1.5rem;
  }

  @media (max-width: 600px) {
    .blog-index {
      padding: 3rem 1rem;
    }

    .blog-header {
      margin-bottom: 2rem;
    }

    .blog-header h1 {
      font-size: clamp(1.9rem, 9vw, 2.2rem);
    }

    .post-card h2 {
      margin: 1.25rem 1.25rem 0.5rem;
    }

    .post-card p {
      margin-right: 1.25rem;
      margin-left: 1.25rem;
    }

    .post-card time {
      margin: 0 1.25rem 1.25rem;
    }
  }
</style>
