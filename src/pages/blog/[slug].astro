---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Abhishek Parpala`} description={post.data.description}>
  <Fragment slot="hero"></Fragment>

  <article class="post">
    <a href="/blog/" class="back-link">← Back to blog</a>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.publishDate.toISOString()}>
      {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <div class="post-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: #4b3cf0;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .post h1 {
    font-size: 2.1rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
  }

  .post > time {
    display: block;
    color: #999;
    font-size: 0.85rem;
    margin-bottom: 2.5rem;
  }

  .post-body {
    color: #333;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .post-body :global(h2) {
    font-size: 1.4rem;
    margin: 2rem 0 1rem;
    letter-spacing: -0.01em;
  }

  .post-body :global(p) {
    margin: 0 0 1.2rem;
  }

  .post-body :global(ul) {
    margin: 0 0 1.2rem;
    padding-left: 1.4rem;
  }

  .post-body :global(li) {
    margin-bottom: 0.6rem;
  }

  .post-body :global(a) {
    color: #4b3cf0;
  }
</style>
